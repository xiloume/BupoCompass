# Configuration de dev local pour l'API BupoCompass
# Renomme ce fichier en .env pour l'utiliser

# Mode SQLite zero-config (pas besoin de MySQL)
DB_DRIVER=sqlite
# Le fichier sera cree a api/database/local.sqlite
DB_PATH=

# JWT
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# App
APP_ENV=development
APP_URL=http://localhost:7000
CORS_ORIGIN=*
