{
  "name": "bupo-compass",
  "version": "0.1.0",
  "description": "Game Completion Tracker - Overlay assistant for 100% game completion",
  "author": {
    "name": "BupoCompass",
    "email": "contact@bupocompass.app"
  },
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node ./scripts/start-electron.js\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "start": "node ./scripts/start-electron.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fast-xml-parser": "^4.5.6",
    "prismarine-nbt": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.6.1",
    "uuid": "^9.0.1",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.bupocompass.app",
    "productName": "BupoCompass",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "web/public/Bupo_compass_icon.png",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "web/public/Bupo_compass_icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BupoCompass"
    },
    "portable": {
      "artifactName": "BupoCompass-${version}-portable.exe"
    },
    "linux": {
      "icon": "web/public/Bupo_compass_icon.png",
      "target": "AppImage"
    }
  }
}
